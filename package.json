{
  "name": "shibumi-server",
  "version": "0.1.31",
  "description": "Small, secure webhook deploy service for rootless Podman.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "shibumi-server": "./src/cli.ts"
  },
  "exports": "./src/index.ts",
  "scripts": {
    "start": "bun src/cli.ts serve",
    "test": "bun test",
    "check": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "bun test && bun run check"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "install.sh",
    "README.md",
    "LICENSE",
    "runtime-lock.json"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "homepage": "https://shibumistack.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitbonsai/shibumi-server.git"
  },
  "bugs": {
    "url": "https://github.com/bitbonsai/shibumi-server/issues"
  },
  "keywords": [
    "shibumi",
    "deploy",
    "webhook",
    "podman",
    "self-host",
    "vps",
    "bun",
    "caddy"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0"
  }
}
